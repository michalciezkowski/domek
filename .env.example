# Skopiuj do .env i uzupełnij wartościami z Firebase Console
# (Ustawienia projektu -> Twoje aplikacje -> Konfiguracja SDK).
# Plik .env NIE trafia do repo (jest w .gitignore).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Ustawienia projektu -> Cloud Messaging -> Web Push certificates -> klucz publiczny (VAPID)
VITE_FIREBASE_VAPID_KEY=
